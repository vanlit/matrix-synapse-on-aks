@startuml
title Matrix Platform on Kubernetes
left to right direction

skinparam componentStyle rectangle
skinparam shadowing false

cloud github

cloud "Azure" {

cloud "Azure Blob Storage" {
    [Media Storage] as media_storage
    [Postgres WAL Archive] as wal_archive
    [Daily Backups] as daily_backups
}

cloud "Azure Key Vault" as akv

node "Azure Kubernetes Service" {
    frame "Edge (HTTPS)" {
        [Traefik] as traefik
    }

    frame "Auth" {
        [Authelia] as authelia
    }

    frame "Control Plane"{
        frame "Secrets Management" {
            [External Secrets Operator] as eso
            [Kubernetes Secret Objects] as kso
        }

        frame "Observability" {
            [Prometheus \n gathers METRICS other services] as prometheus
            [Grafana] as grafana
            [Loki \n gathers LOGS other services] as loki
            [Node Exporter] as node_exporter
            [kube-state-metrics] as kube_state_metrics
        }

        frame "GitOps" {
            [ArgoCD \n sets up EVERYTHING in this AKS] as argocd
        }
    }

    frame "Calls Namespace\n(dedicated node pool, hostNetwork,\nNSG opens UDP/TCP media ports)" as calls_ns {
        [coturn\nlegacy 1:1 calls\nUDP 3478, TLS 5349,\nrelay range] as coturn

        [LiveKit SFU\ngroup calls / MatrixRTC\nUDP media range, TCP 7881 fallback,\nWS signalling] as livekit
        
        [lk-jwt-service\nmints LiveKit tokens\nafter Matrix identity check] as lk_jwt
    }

    frame "Matrix Namespace" {

        [Element Web\n(+ Element Call)] as element_web

        package "Synapse Workers. \n State in PG, \n case&queues in Redis" as SW {

            [Synapse Main\nTURN creds via shared secret,\nMatrixRTC enabled] as synapse_main
            [Client Reader] as client_reader
            [Federation Reader] as federation_reader
            [Background Worker] as background_worker
            [Media Worker] as media_worker
        }

        database "CloudNativePG" as pg

        package "Redis" as redis {
            [Redis Master] as redis_master
            [Redis Replica] as redis_replica
            [Redis Sentinel] as redis_sentinel
        }

        [Backup Worker] as backup_worker
    }
}

}


cloud "Internet \n all https comms come via traefik \n media via coturn (legacy) or LiveKit (MatrixRTC)" as internet

' =========================
' INTERNET / ENTRY
' =========================
internet -[#FFFF00]---> traefik : HTTPS
internet -[#FFFF00]---> coturn : STUN/TURN\n(UDP/TCP, direct)
internet -[#FFFF00]---> livekit : WebRTC media\n(UDP/TCP, direct)

traefik --> element_web : forward web UI
traefik --> synapse_main : forward Matrix API
traefik -[#0066CC]-> authelia : forward auth requests\n for OIDC flow
traefik -[#7B3FF2]-> lk_jwt : forward token requests
traefik -[#7B3FF2]-> livekit : forward WebSocket signalling

element_web --> synapse_main : use Matrix Client-Server API

synapse_main -[#0066CC]-> authelia : authenticate users

' =========================
' CALLS (PURPLE)
' =========================
lk_jwt -[#7B3FF2]-> synapse_main : validate OpenID token\n(Matrix identity)
lk_jwt .[#7B3FF2].> livekit : signed join tokens\n(shared API key/secret)

' =========================
' DATABASE (RED)
' =========================
SW -[#CC0000]-> pg

pg -[#CC0000]-> backup_worker : fetched by,\n for backups
backup_worker -[#CC0000]-> daily_backups : create backups
backup_worker -[#CC0000]-> wal_archive

' =========================
' REDIS (ORANGE)
' =========================
SW -[#FF8C00]-> redis_master

redis_master -[#FF8C00]-> redis_replica : replicate data
redis_sentinel .[#FF8C00].> redis_master : monitor master
redis_sentinel .[#FF8C00].> redis_replica : monitor replica

' =========================
' MEDIA (GREEN)
' =========================

media_worker -[#228B22]-> media_storage : store media files

' =========================
' OBSERVABILITY
' =========================
prometheus -[#black,dotted]-> synapse_main
prometheus -[#black,dotted]-> pg
prometheus -[#black,dotted]-> redis_master
prometheus -[#black,dotted]-> traefik : scrape metrics
prometheus -[#black,dotted]-> coturn
prometheus -[#black,dotted]-> livekit
prometheus -[#black,dotted]-> kube_state_metrics
prometheus -[#black,dotted]-> node_exporter

grafana --> prometheus : query metrics
grafana --> loki : query logs


' =========================
' SECRETS (PINK)
' =========================

eso -[#FF69B4]-> akv : request secrets
eso -[#FF69B4]-> kso : write secrets

kso -[#11ddaa]-> traefik : apply TLS secrets
kso -[#11ddaa]-> authelia : apply auth secrets
kso -[#11ddaa]-> SW : apply secrets\n(incl. TURN shared secret)
kso -[#11ddaa]-> pg : apply database credentials
kso -[#11ddaa]-> redis : apply Redis credentials
kso -[#11ddaa]-> coturn : apply TURN shared secret\n+ TLS cert
kso -[#11ddaa]-> livekit : apply LiveKit API key/secret
kso -[#11ddaa]-> lk_jwt : apply LiveKit API key/secret

note bottom of calls_ns
  Synapse never calls coturn at runtime: it derives
  time-limited TURN credentials (HMAC) from the shared
  secret that coturn also holds.
  Clients advertise the SFU via .well-known (rtc_foci).
end note

@enduml
