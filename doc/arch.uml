@startuml
title Matrix Platform on Kubernetes
left to right direction

skinparam componentStyle rectangle
skinparam shadowing false

cloud github

cloud "Azure" {

node "Azure Blob Storage Containers" {
    [Media Storage] as media_storage
    [PG WAL Archive] as wal_archive
    [PG Daily Backups] as daily_backups
}

cloud "Azure Key Vault" as akv

node "Azure Kubernetes Service" {
    frame "Edge (HTTPS)" {
        [Traefik\n<back:cyan> KSO: TLS secrets </back>\n<back:pink> L&M </back>] as traefik
    }

    frame "Auth" {
        [Authelia\n<back:cyan> KSO: session-key, storage-encryption and JWT secrets, OIDC client entries (hashed)</back>\n<back:pink> L&M </back>] as authelia
    }

    frame "Control Plane"{
        frame "Secrets Management" {
            [External Secrets Operator\n<back:lightgreen> WI: Key Vault access </back>\n<back:pink> L&M </back>] as eso
            [Kubernetes Secret Objects (KSO)] as kso #cyan
        }

        frame "Observability" {
            [Prometheus \n gathers METRICS from services marked with <back:pink>M</back>\n<back:pink> L&M </back>] as prometheus
            [Grafana\n<back:cyan> KSO: admin password, OIDC client secret </back>\n<back:pink> L&M </back>] as grafana
            [Loki \n gathers LOGS from services  marked with <back:pink>L</back>\n<back:pink> L&M </back>] as loki
            [Node Exporter\n<back:pink> M </back>] as node_exporter
            [kube-state-metrics\n<back:pink> M </back>] as kube_state_metrics
        }

        frame "GitOps" {
            [ArgoCD \n sets up EVERYTHING in this AKS\n<back:orange> BOOTSTRAP: Git deploy key / GitHub App,\nOCI chart registry creds (if private) </back>\n<back:pink> L&M </back>] as argocd
        }
    }

    frame "Calls Namespace\n(dedicated node pool, hostNetwork,\nNSG opens UDP/TCP media ports)" as calls_ns {
        [coturn\nlegacy 1:1 calls\nUDP 3478, TLS 5349,\nrelay range\n<back:cyan> KSO: TURN shared secret + TLS cert </back>\n<back:pink> L&M </back>] as coturn

        [LiveKit SFU\ngroup calls / MatrixRTC\nUDP media range, TCP 7881 fallback,\nWS signalling\n<back:cyan> KSO: LiveKit API key/secret </back>\n<back:pink> L&M </back>] as livekit

        [lk-jwt-service\nmints LiveKit tokens\nafter Matrix identity check\n<back:cyan> KSO: LiveKit API key/secret </back>\n<back:pink> L&M </back>] as lk_jwt
    }

    frame "Matrix Namespace" {

        [Element Web\n(+ Element Call)\npublic SPA config, no secrets\n<back:pink> L&M </back>] as element_web

        package "Synapse Workers. \n State in PG, \n case&queues in Redis\n<back:cyan> KSO: OIDC client secret (Authelia), signing key, macaroon/form secrets, worker replication secret, DB + Redis credentials, TURN shared secret </back>\n<back:pink> L&M </back>" as SW {

            [Synapse Main\nTURN creds via shared secret,\nMatrixRTC enabled] as synapse_main
            [Client Reader] as client_reader
            [Federation Reader] as federation_reader
            [Background Worker] as background_worker
            [Media Worker\n<back:lightgreen> WI: Blob write (media) </back>] as media_worker
        }

        database "CloudNativePG\n<back:cyan> KSO: database credentials </back>\n<back:lightgreen> WI: Blob write (WAL archive) </back>\n<back:pink> L&M </back>" as pg

        package "Redis\n<back:cyan> KSO: Redis credentials </back>\n<back:pink> L&M </back>" as redis {
            [Redis Master] as redis_master
            [Redis Replica] as redis_replica
            [Redis Sentinel] as redis_sentinel
        }

        [Backup Worker\n<back:cyan> KSO: read-only DB role credentials </back>\n<back:lightgreen> WI: Blob write (backups) </back>\n<back:pink> L&M </back>] as backup_worker
    }
}

}

argocd ..> github : fetch repo,\n periodically

cloud "Internet \n all https comms come via traefik \n media via coturn (legacy) or LiveKit (MatrixRTC)" as internet

' =========================
' INTERNET / ENTRY
' =========================
internet -[#FFFF00]---> traefik : HTTPS
internet -[#FFFF00]---> coturn : STUN/TURN\n(UDP/TCP, direct)
internet -[#FFFF00]---> livekit : WebRTC media\n(UDP/TCP, direct)

traefik --> element_web : forward web UI
traefik --> synapse_main : forward Matrix API
traefik -[#0066CC]-> authelia : forward auth requests\n for OIDC flow
traefik -[#7B3FF2]-> lk_jwt : forward token requests
traefik -[#7B3FF2]-> livekit : forward WebSocket signalling

element_web --> synapse_main : use Matrix Client-Server API

synapse_main -[#0066CC]-> authelia : authenticate users\n(OIDC code exchange)

' =========================
' CALLS (PURPLE)
' =========================
lk_jwt -[#7B3FF2]-> synapse_main : validate OpenID token\n(Matrix identity)
lk_jwt .[#7B3FF2].> livekit : signed join tokens\n(shared API key/secret)

' =========================
' DATABASE (RED)
' =========================
SW -[#CC0000]-> pg

pg -[#CC0000]-> backup_worker : fetched by,\n for backups
pg -[#CC0000]-> wal_archive : archive WAL
backup_worker -[#CC0000]-> daily_backups : create backups

' =========================
' REDIS (ORANGE)
' =========================
SW -[#FF8C00]-> redis_master

redis_master -[#FF8C00]-> redis_replica : replicate data
redis_sentinel .[#FF8C00].> redis_master : monitor master
redis_sentinel .[#FF8C00].> redis_replica : monitor replica

' =========================
' MEDIA (GREEN)
' =========================

media_worker -[#228B22]-> media_storage : store media files

' =========================
' OBSERVABILITY
' Prometheus/Loki collection is shown as "L&M" stamps
' inside the modules instead of scrape/ship edges.
' =========================

grafana --> prometheus : query metrics
grafana --> loki : query logs


' =========================
' SECRETS (PINK)
' Stamps inside module labels replace arrows from kso.
' =========================

eso -[#FF69B4]-> akv : request secrets
eso -[#FF69B4]-> kso : write secrets

note bottom of calls_ns
  Synapse never calls coturn at runtime: it derives
  time-limited TURN credentials (HMAC) from the shared
  secret that coturn also holds.
  Clients advertise the SFU via .well-known (rtc_foci).
end note

legend right
  Colored Stamps:
  <back:cyan> KSO </back> secret delivered via Kubernetes Secret Objects (from Key Vault via ESO)
  <back:lightgreen> WI </back> Azure Workload Identity, no stored secret
  <back:orange> BOOTSTRAP </back> installed out-of-band, cannot come from ESO (ArgoCD deploys ESO)
  <back:pink> L&M </back> Logs gathered by Loki, Metrics scraped by Prometheus (M = metrics only)
  Container images are pulled by the kubelet (imagePullSecrets or
  ACR pull-through cache via AKS managed identity), not by ArgoCD.
endlegend

@enduml
